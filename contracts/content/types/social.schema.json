{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:social:v1",
  "title": "TBCG 好友规则 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "content_id",
        "game_id",
        "max_friends",
        "revision",
        "schema_version"
      ],
      "properties": {
        "max_friends": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_pending_requests"
      ],
      "properties": {
        "max_pending_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
