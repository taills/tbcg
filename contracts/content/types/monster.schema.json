{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:monster:v1",
  "title": "TBCG 怪物 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "appearance_id",
        "content_id",
        "display_name",
        "game_id",
        "level",
        "revision",
        "schema_version"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "appearance_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/appearance_id"
        },
        "level": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/level"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency_reward",
        "exp_reward",
        "loot",
        "skill_chance_bp",
        "skill_ids",
        "stats"
      ],
      "properties": {
        "stats": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/stats"
        },
        "skill_ids": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/refs"
        },
        "skill_chance_bp": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/basis_points"
        },
        "exp_reward": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/amount"
        },
        "currency_reward": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/amount"
        },
        "loot": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chance_bp",
              "item_id",
              "quantity"
            ],
            "properties": {
              "item_id": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
              },
              "chance_bp": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/basis_points"
              },
              "quantity": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/count"
              }
            }
          }
        }
      }
    }
  }
}
