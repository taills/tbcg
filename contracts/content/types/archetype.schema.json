{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:archetype:v1",
  "title": "TBCG 角色原型 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "appearance_id",
        "content_id",
        "display_name",
        "game_id",
        "revision",
        "schema_version"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "description": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/text"
        },
        "appearance_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/appearance_id"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_stats",
        "default_skill_ids",
        "growth_per_level",
        "level_exp",
        "start_anchor_id",
        "start_currency",
        "start_items",
        "start_map_id"
      ],
      "properties": {
        "base_stats": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/stats"
        },
        "growth_per_level": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/stat_bonus"
        },
        "level_exp": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/level_exp"
        },
        "start_map_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
        },
        "start_anchor_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/anchor_id"
        },
        "start_currency": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/amount"
        },
        "start_items": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/stacks"
        },
        "default_skill_ids": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/refs"
        }
      }
    }
  }
}
