{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:pet:v1",
  "title": "TBCG 宠物 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "appearance_id",
        "content_id",
        "display_name",
        "game_id",
        "revision",
        "schema_version",
        "skill_ids"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "appearance_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/appearance_id"
        },
        "skill_ids": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/refs"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_stats",
        "growth_per_level",
        "level_exp"
      ],
      "properties": {
        "base_stats": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/stats"
        },
        "growth_per_level": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/stat_bonus"
        },
        "level_exp": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/level_exp"
        }
      }
    }
  }
}
