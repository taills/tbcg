{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:encounter:v1",
  "title": "TBCG 遭遇 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "content_id",
        "display_name",
        "game_id",
        "revision",
        "schema_version"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "description": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/text"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_flee",
        "max_rounds",
        "monsters",
        "round_timeout_ms"
      ],
      "properties": {
        "monsters": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "monster_id"
            ],
            "properties": {
              "monster_id": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          },
          "minItems": 1
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "round_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "allow_flee": {
          "type": "boolean"
        }
      }
    }
  }
}
