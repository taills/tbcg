{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:event:v1",
  "title": "TBCG 活动 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "content_id",
        "display_name",
        "game_id",
        "leaderboard",
        "max_claims_per_window",
        "objective",
        "revision",
        "schema_version",
        "windows"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "description": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/text"
        },
        "windows": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "end",
              "start"
            ],
            "properties": {
              "start": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/timestamp"
              },
              "end": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/timestamp"
              }
            }
          },
          "minItems": 1
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "kind",
            "target_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "defeat_encounter",
                "complete_dungeon"
              ]
            },
            "target_id": {
              "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
            },
            "count": {
              "$ref": "urn:tbcg:content:common:v1#/$defs/count"
            }
          }
        },
        "max_claims_per_window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "leaderboard": {
          "type": "boolean"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rewards"
      ],
      "properties": {
        "rewards": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/rewards"
        }
      }
    }
  }
}
