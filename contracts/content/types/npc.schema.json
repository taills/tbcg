{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:npc:v1",
  "title": "TBCG NPC Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "anchor_id",
        "appearance_id",
        "content_id",
        "display_name",
        "game_id",
        "map_id",
        "revision",
        "schema_version"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "appearance_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/appearance_id"
        },
        "map_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
        },
        "anchor_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/anchor_id"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interact_range_cells",
        "nodes",
        "start_node"
      ],
      "properties": {
        "interact_range_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "start_node": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/local_id"
        },
        "nodes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "options",
              "text"
            ],
            "properties": {
              "node_id": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/local_id"
              },
              "text": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/text"
              },
              "options": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "option_id",
                    "text"
                  ],
                  "properties": {
                    "option_id": {
                      "$ref": "urn:tbcg:content:common:v1#/$defs/local_id"
                    },
                    "text": {
                      "$ref": "urn:tbcg:content:common:v1#/$defs/name"
                    },
                    "condition": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [],
                      "properties": {
                        "quest_id": {
                          "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
                        },
                        "quest_status": {
                          "enum": [
                            "available",
                            "active",
                            "objectives_done",
                            "completed",
                            "not_completed"
                          ]
                        },
                        "min_level": {
                          "$ref": "urn:tbcg:content:common:v1#/$defs/level"
                        },
                        "sect_id": {
                          "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
                        },
                        "no_sect": {
                          "type": "boolean"
                        }
                      }
                    },
                    "action": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "goto",
                            "close",
                            "accept_quest",
                            "talk_objective",
                            "deliver_item",
                            "claim_quest",
                            "start_encounter",
                            "join_sect",
                            "open_shop",
                            "enter_dungeon",
                            "recruit_partner",
                            "grant_pet",
                            "open_crafting"
                          ]
                        },
                        "target_id": {
                          "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
                        },
                        "next_node": {
                          "$ref": "urn:tbcg:content:common:v1#/$defs/local_id"
                        }
                      }
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
