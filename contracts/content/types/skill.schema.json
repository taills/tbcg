{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:skill:v1",
  "title": "TBCG 技能 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "content_id",
        "display_name",
        "game_id",
        "kind",
        "mp_cost",
        "revision",
        "schema_version",
        "target"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "description": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/text"
        },
        "kind": {
          "enum": [
            "damage",
            "heal",
            "buff"
          ]
        },
        "target": {
          "enum": [
            "enemy_single",
            "enemy_all",
            "ally_single",
            "ally_all",
            "self"
          ]
        },
        "mp_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crit_rate_bp",
        "hits",
        "power_percent"
      ],
      "properties": {
        "power_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "hits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "crit_rate_bp": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/basis_points"
        },
        "buff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "stat",
            "turns"
          ],
          "properties": {
            "stat": {
              "enum": [
                "attack",
                "defense",
                "speed"
              ]
            },
            "amount": {
              "type": "integer",
              "minimum": -10000,
              "maximum": 10000
            },
            "turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      }
    }
  }
}
