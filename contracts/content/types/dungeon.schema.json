{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:dungeon:v1",
  "title": "TBCG 副本 Definition v1",
  "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "content_id",
    "game_id",
    "public",
    "revision",
    "schema_version",
    "server"
  ],
  "properties": {
    "public": {
      "$ref": "#/$defs/public"
    },
    "server": {
      "$ref": "#/$defs/server"
    }
  },
  "$defs": {
    "public": {
      "$ref": "urn:tbcg:content:common:v1#/$defs/identity",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "content_id",
        "daily_limit",
        "display_name",
        "game_id",
        "max_players",
        "min_level",
        "min_players",
        "revision",
        "schema_version",
        "stage_names"
      ],
      "properties": {
        "display_name": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/name"
        },
        "description": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/text"
        },
        "min_players": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_players": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "min_level": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/level"
        },
        "daily_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "stage_names": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "urn:tbcg:content:common:v1#/$defs/name"
          },
          "minItems": 1
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_npc_id",
        "rewards",
        "stages"
      ],
      "properties": {
        "entry_npc_id": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
        },
        "stages": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encounter_id"
            ],
            "properties": {
              "encounter_id": {
                "$ref": "urn:tbcg:content:common:v1#/$defs/ref"
              }
            }
          },
          "minItems": 1
        },
        "rewards": {
          "$ref": "urn:tbcg:content:common:v1#/$defs/rewards"
        }
      }
    }
  }
}
