{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tbcg:content:item:v1",
  "title": "TBCG item Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["game_id", "content_id", "revision", "schema_version", "public", "server"],
  "properties": {
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "content_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "schema_version": { "const": 1 },
    "public": { "$ref": "urn:tbcg:content:item-public:v1" },
    "server": { "$ref": "#/$defs/server_rules" }
  },
  "$defs": {
    "server_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reward_value_minor", "drop_weight_basis_points"],
      "properties": {
        "reward_value_minor": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,17})$" },
        "drop_weight_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
